[Unit]
Description=Cert Alerter: TLS certificate expiry monitoring with e-mail alerts
After=network-online.target
Wants=network-online.target
# With a local MySQL/MariaDB uncomment one of:
#After=network-online.target mysql.service
#After=network-online.target mariadb.service

[Service]
Type=simple
User=cert-alerter
Group=cert-alerter

# Command line flags (ARGS) and CERT_ALERTER_* variables are read from this file.
EnvironmentFile=-/etc/default/cert-alerter
ExecStart=/usr/local/bin/cert-alerter serve $ARGS
# "systemctl reload cert-alerter" reopens the log files (log rotation).
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE=65536

# /var/lib/cert-alerter (database, secret key) and /var/log/cert-alerter
# (optional log files) are created by systemd and owned by the service user.
StateDirectory=cert-alerter
StateDirectoryMode=0750
LogsDirectory=cert-alerter
LogsDirectoryMode=0750
WorkingDirectory=/var/lib/cert-alerter
UMask=0027

# Hardening. The whole file system is read-only for the service except the
# directories above; add ReadWritePaths= for anything else it must write.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
# To listen on a port below 1024 (e.g. -listen=:443 with -tls-cert), replace
# the two lines above with:
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
